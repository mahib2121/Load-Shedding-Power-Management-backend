model Substation {
  id String @id @default(uuid())

  name String
  code String @unique

  capacityMW Float?

  zoneId String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relationships
  zone    Zone     @relation(fields: [zoneId], references: [id])
  feeders Feeder[]

  @@index([zoneId])
  @@index([deletedAt])
}
