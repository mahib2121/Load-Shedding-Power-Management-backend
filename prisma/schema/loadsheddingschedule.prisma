model LoadSheddingSchedule {
  id String @id @default(uuid())

  name String
  date DateTime

  expectedDemandMW    Float
  availableSupplyMW   Float
  requiredReductionMW Float

  status ScheduleStatus @default(DRAFT)

  zoneId String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relationships
  zone  Zone           @relation(fields: [zoneId], references: [id])
  slots ScheduleSlot[]

  @@index([zoneId])
  @@index([date])
  @@index([status])
  @@index([deletedAt])
}
