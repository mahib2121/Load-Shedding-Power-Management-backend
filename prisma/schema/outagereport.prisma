model OutageReport {
  id          String   @id @default(uuid())

  description String?

  latitude    Float?
  longitude   Float?

  userId      String
  areaId      String
  outageId    String?

  createdAt   DateTime @default(now())

  // Relationships
  user        User    @relation(fields: [userId], references: [id])
  area        Area    @relation(fields: [areaId], references: [id])
  outage      Outage? @relation(fields: [outageId], references: [id])

  @@index([userId])
  @@index([areaId])
  @@index([outageId])
  @@index([createdAt])
}