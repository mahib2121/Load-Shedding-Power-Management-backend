model Notification {
  id        String           @id @default(uuid())
  userId    String

  type      NotificationType
  title     String
  message   String

  isRead    Boolean          @default(false)

  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}