model Zone {
  id String @id @default(uuid())

  name        String
  code        String  @unique
  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relationships
  users       User[]
  substations Substation[]
  schedules   LoadSheddingSchedule[]
  outages     Outage[]

  @@index([deletedAt])
}
